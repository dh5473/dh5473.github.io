-interpreter-lock/","title":"[Python] Global Interpreter Lock","seriesOrder":3},{"slug":"/python/synchronize-thread/","title":"[Python] Thread Synchronization","seriesOrder":4}],"prevPost":{"slug":"/python/reference-counting/","title":"[Python] Reference Counting"},"nextPost":{"slug":"/python/global-interpreter-lock/","title":"[Python] Global Interpreter Lock"},"quiz":null}},"staticQueryHashes":[],"slicesMap":{}}