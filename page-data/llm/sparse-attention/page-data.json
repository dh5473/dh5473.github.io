al\">⊤</mi></msup><msub><mi>s</mi><mn>1</mn></msub><mo separator=\"true\">,</mo><mtext>  </mtext><msup><mi>q</mi><mi mathvariant=\"normal\">⊤</mi></msup><msub><mi>s</mi><mn>2</mn></msub><mo separator=\"true\">,</mo><mtext>  </mtext><mo>…</mo><mo separator=\"true\">,</mo><mtext>  </mtext><msup><mi>q</mi><mi mathvariant=\"normal\">⊤</mi></msup><msub><mi>s</mi><mrow><mi>n</mi><mi mathvariant=\"normal\">/</mi><mi>r</mi></mrow></msub><mo fence=\"true\" stretchy=\"true\" minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><annotation encoding=\"application/x-tex\">s_j = \\frac{1}{r}\\sum_{i \\in B_j} k_i, \\qquad \\text{selected} = \\operatorname{top-}k\\bigl(q^\\top s_1,\\; q^\\top s_2,\\; \\dots,\\; q^\\top s_{n/r}\\bigr)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7167em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">s</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.05724em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.8131em;vertical-align:-1.4917em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3214em;\"><span style