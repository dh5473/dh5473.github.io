9/thumbnail.webp 1080w,\n/static/c8f95a34cba948bf9948de785e997e40/c895b/thumbnail.webp 1200w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"8ca59571-7264-5ad6-b140-5b5fe51eff8d","fields":{"slug":"/llm/llm-quantization-serving/"},"frontmatter":{"title":"서빙을 위한 양자화 가이드 FP8, AWQ, GPTQ","summary":"AWQ와 GPTQ는 가중치만 4비트로 줄이는 W4A16, FP8은 보통 가중치와 활성값을 모두 8비트로 줄이는 W8A8 양자화입니다. 무엇을 줄이느냐에 따라 빨라지는 경로가 달라서 배치 크기와 GPU 세대에 따라 고를 기법이 갈립니다. KV Cache FP8 양자화와 QAT까지 정리합니다.","date":"2026.07.18.","category":"LLM","series":"llm-serving","seriesOrder":6,"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAAKCAIAAAA7N+mxAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAjUlEQVR42mP4TwFgoL7mf/+A6B+M/e/v379wLiHN/8CIbJs/f/n+7PmL9+/ff/78+datW5cuXbp37x7EFbg1g+W+vTy19tDdcxcuP3hw/8mTpydOnJgzZ87JkyeBUkD347EZpPnjh5fn732+fPH8hQsXz507B7Tz7du3z58/J2QziiNQANF+xqmYqvEMALZMS7Wh4IGoAAAAAElFTkSuQmCC"},"backgroundColor":"transparent","images":{"fallback":{"src":"/static/c8f95a34cba948bf9948de785e997e40/ff2cd/thumbnail.png","srcSet":"/static/c8f95a34cba948bf9948de785e997e40/bcf32/thumbnail.png 750w,\n/static/c8f95a34cba948bf9948de785e997e40/ff2cd/thumbnail.png 768w,\n/static/c8f95a34cba948bf9948de785e997e40/475f8/thumbnail.png 1080w,\n/static/c8f95a34cba948bf9948de785e997e40/85c70/thumbnail.png 1200w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/c8f95a34cba948bf9948de785e997e40/3225c/thumbnail.avif 750w,\n/static/c8f95a34cba948bf9948de785e997e40/b7b85/thumbnail.avif 768w,\n/static/c8f95a34cba948bf9948de785e997e40/97eec/thumbnail.avif 1080w,\n/static/c8f95a34cba948bf9948de785e997e40/56c83/thumbnail.avif 1200w","type":"image/avif","sizes":"(min-width: 768px) 768px, 100vw"},{"srcSet":"/static/c8f95a34cba948bf9948de785e997e40/2c6fe/thumbnail.webp 750w,\n/static/c8f95a34cba948bf9948de785e997e40/6571b/thumbnail.webp 768w,\n/static/c8f95a34cba94