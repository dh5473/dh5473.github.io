ail.png","srcSet":"/static/f8a1fd18d31cab453d18daf81e96515a/bcf32/thumbnail.png 750w,\n/static/f8a1fd18d31cab453d18daf81e96515a/ff2cd/thumbnail.png 768w,\n/static/f8a1fd18d31cab453d18daf81e96515a/475f8/thumbnail.png 1080w,\n/static/f8a1fd18d31cab453d18daf81e96515a/85c70/thumbnail.png 1200w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/f8a1fd18d31cab453d18daf81e96515a/3225c/thumbnail.avif 750w,\n/static/f8a1fd18d31cab453d18daf81e96515a/b7b85/thumbnail.avif 768w,\n/static/f8a1fd18d31cab453d18daf81e96515a/97eec/thumbnail.avif 1080w,\n/static/f8a1fd18d31cab453d18daf81e96515a/56c83/thumbnail.avif 1200w","type":"image/avif","sizes":"(min-width: 768px) 768px, 100vw"},{"srcSet":"/static/f8a1fd18d31cab453d18daf81e96515a/2c6fe/thumbnail.webp 750w,\n/static/f8a1fd18d31cab453d18daf81e96515a/6571b/thumbnail.webp 768w,\n/static/f8a1fd18d31cab453d18daf81e96515a/af729/thumbnail.webp 1080w,\n/static/f8a1fd18d31cab453d18daf81e96515a/c895b/thumbnail.webp 1200w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"3ae4a82b-897f-570f-8440-a831c821d8d2","fields":{"slug":"/postgres/gin-gist-brin-hash/"},"frontmatter":{"title":"B-tree 너머: GIN, GiST, BRIN, Hash는 언제 쓰는가","summary":"전문 검색, JSONB 포함 관계, 시계열 거대 테이블처럼 B-tree가 다루지 못하는 영역이 있습니다. GIN·GiST·BRIN·Hash의 내부 구조가 각각 어떤 접근 패턴에 최적화돼 있는지, 언제 쓰고 언제 쓰면 안 되는지를 짚어봅니다.","date":"2026.04.18.","category":"Database","series":"postgres","seriesOrder":5,"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"backgroundColor":"transparent","images":{"fallback":{"src":"/static/f8a1fd18d31cab453d18daf81e96515a/ff2cd/thumbnail.png","srcSet":"/static/f8a1fd18d31cab453d18daf81e96515a/bcf32/thumbnail.png 750w,\n/static/f8a1fd18d31cab453d18daf81e96515a/ff2cd/thumbnail.png 768w,\n/static/f8a1fd18d31cab453d18daf81e96515a/475f8/thumbnail.png 1080w,\n/static/f8a1fd18d31cab453d18daf81e96515a/85c70/thumbnail.png